[Unit]
Description=Aperture Lab first-boot setup
ConditionPathExists=!/var/lib/aperture/configured
After=network-online.target NetworkManager.service systemd-user-sessions.service
Wants=network-online.target
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/aperture-firstboot
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
